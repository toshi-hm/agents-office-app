{
  "name": "agents-office-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "bun run --cwd apps/server dev",
    "dev:web": "bun run --cwd apps/desktop dev",
    "dev": "bun run scripts/dev-web.ts",
    "tauri:dev": "bun run scripts/tauri.ts dev",
    "tauri:build": "bun run scripts/tauri.ts build",
    "build:desktop": "bun run --cwd apps/desktop build",
    "build:server": "bun run --cwd apps/server build",
    "build": "bun run build:desktop && bun run build:server",
    "typecheck": "bunx tsc --noEmit -p tsconfig.typecheck.json",
    "test": "bun test packages apps scripts/ci"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2"
  }
}
